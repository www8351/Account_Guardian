# MD files stay local except README, versioned docs, and the governance record
*.md
!README.md
!docs/**/*.md
!LEDGER.md

# Build artifacts
*.ex5

# Secrets
.env
.env.*
*.pem
*.key
*.pfx
*.p12
secrets.*
credentials.*

# Junk
__pycache__/
*.pyc
.venv/
node_modules/
*.log

# Owner profile backups of CLAUDE.md, local config residue
CLAUDE.md.bak*

# Local tooling scaffolding. Everything under it today is worktrees, which are
# full checkouts of this repository and must never enter history.
.claude/

# Root-level duplicate of docs/status/index.html, identical byte for byte.
# The versioned copy under docs/ is the one that counts.
/Monitor_Plan.html

